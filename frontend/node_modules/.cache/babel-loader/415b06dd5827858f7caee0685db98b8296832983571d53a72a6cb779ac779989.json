{"ast":null,"code":"import api from '../utils/axios';\nexport default {\n  name: 'Register',\n  data() {\n    return {\n      form: {\n        email: '',\n        password: '',\n        role: 'student',\n        name: '',\n        cgpa: '',\n        company_name: ''\n      }\n    };\n  },\n  methods: {\n    async handleRegister() {\n      try {\n        const response = await api.post('/auth/register', this.form);\n        alert(response.data.message + \" You can now login.\");\n        this.$router.push('/');\n      } catch (error) {\n        const errorMsg = error.response?.data?.error || \"Registration failed!\";\n        alert(\"Oops: \" + errorMsg);\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","form","email","password","role","cgpa","company_name","methods","handleRegister","response","post","alert","message","$router","push","error","errorMsg"],"sources":["src/views/Register.vue"],"sourcesContent":["\r\n<template>\r\n  <div class=\"container d-flex justify-content-center align-items-center\" style=\"min-height: 100vh;\">\r\n    \r\n    <div class=\"glass-card\" style=\"width: 100%; max-width: 500px;\">\r\n      <h2 class=\"text-center mb-4\">Create an Account</h2>\r\n      \r\n      <form @submit.prevent=\"handleRegister\">\r\n        \r\n        <!-- Standard Fields for Everyone -->\r\n        <div class=\"mb-3\">\r\n          <label class=\"form-label\">Email address</label>\r\n          <input type=\"email\" class=\"form-control glass-input\" v-model=\"form.email\" required>\r\n        </div>\r\n        \r\n        <div class=\"mb-3\">\r\n          <label class=\"form-label\">Password</label>\r\n          <input type=\"password\" class=\"form-control glass-input\" v-model=\"form.password\" required>\r\n        </div>\r\n\r\n        <div class=\"mb-3\">\r\n          <label class=\"form-label\">I am a...</label>\r\n          <select class=\"form-select glass-input\" v-model=\"form.role\" style=\"background-color: #2c5364;\" required>\r\n            <option value=\"student\">Student</option>\r\n            <option value=\"company\">Company</option>\r\n          </select>\r\n        </div>\r\n\r\n        <!-- Dynamic Fields: ONLY show if Student is selected -->\r\n        <div v-if=\"form.role === 'student'\" class=\"mb-3 p-3\" style=\"background: rgba(0,0,0,0.2); border-radius: 10px;\">\r\n          <div class=\"mb-2\">\r\n            <label class=\"form-label\">Full Name</label>\r\n            <input type=\"text\" class=\"form-control glass-input\" v-model=\"form.name\" required>\r\n          </div>\r\n          <div class=\"mb-2\">\r\n            <label class=\"form-label\">Current CGPA</label>\r\n            <input type=\"number\" step=\"0.1\" class=\"form-control glass-input\" v-model=\"form.cgpa\" required>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Dynamic Fields: ONLY show if Company is selected -->\r\n        <div v-if=\"form.role === 'company'\" class=\"mb-3 p-3\" style=\"background: rgba(0,0,0,0.2); border-radius: 10px;\">\r\n          <div class=\"mb-2\">\r\n            <label class=\"form-label\">Company Name</label>\r\n            <input type=\"text\" class=\"form-control glass-input\" v-model=\"form.company_name\" required>\r\n          </div>\r\n        </div>\r\n        \r\n        <button type=\"submit\" class=\"btn btn-glass-primary w-100 py-2 mt-2\">\r\n          Register\r\n        </button>\r\n      </form>\r\n      \r\n      <div class=\"text-center mt-4\">\r\n        <small>Already have an account? <router-link to=\"/\" class=\"text-info\">Login here</router-link></small>\r\n      </div>\r\n    </div>\r\n    \r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../utils/axios';\r\n\r\nexport default {\r\n  name: 'Register',\r\n  data() {\r\n    return {\r\n      form: {\r\n        email: '',\r\n        password: '',\r\n        role: 'student', \r\n        name: '',\r\n        cgpa: '',\r\n        company_name: ''\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n      try {\r\n        const response = await api.post('/auth/register', this.form);\r\n        alert(response.data.message + \" You can now login.\");\r\n        \r\n        this.$router.push('/');\r\n      } catch (error) {\r\n        const errorMsg = error.response?.data?.error || \"Registration failed!\";\r\n        alert(\"Oops: \" + errorMsg);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AA8DA,OAAAA,GAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;QACAC,KAAA;QACAC,QAAA;QACAC,IAAA;QACAL,IAAA;QACAM,IAAA;QACAC,YAAA;MACA;IACA;EACA;EACAC,OAAA;IACA,MAAAC,eAAA;MACA;QACA,MAAAC,QAAA,SAAAX,GAAA,CAAAY,IAAA,wBAAAT,IAAA;QACAU,KAAA,CAAAF,QAAA,CAAAT,IAAA,CAAAY,OAAA;QAEA,KAAAC,OAAA,CAAAC,IAAA;MACA,SAAAC,KAAA;QACA,MAAAC,QAAA,GAAAD,KAAA,CAAAN,QAAA,EAAAT,IAAA,EAAAe,KAAA;QACAJ,KAAA,YAAAK,QAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}