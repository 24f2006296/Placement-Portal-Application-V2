{"ast":null,"code":"import api from '../utils/axios';\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      email: '',\n      password: ''\n    };\n  },\n  methods: {\n    async handleLogin() {\n      try {\n        const response = await api.post('/auth/login', {\n          email: this.email,\n          password: this.password\n        });\n        localStorage.setItem('token', response.data.token);\n        localStorage.setItem('role', response.data.role);\n        const role = response.data.role;\n        if (role === 'admin') this.$router.push('/admin');else if (role === 'company') this.$router.push('/company');else if (role === 'student') this.$router.push('/student');\n      } catch (error) {\n        alert(\"Login Failed!\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","email","password","methods","handleLogin","response","post","localStorage","setItem","token","role","$router","push","error","alert"],"sources":["src/views/Login.vue"],"sourcesContent":["<template>\r\n  <div class=\"container d-flex justify-content-center align-items-center\" style=\"min-height: 100vh;\">\r\n    <div class=\"glass-card\" style=\"width: 100%; max-width: 400px;\">\r\n      <h2 class=\"text-center mb-4\">Placement Portal</h2>\r\n      <form @submit.prevent=\"handleLogin\">\r\n        <div class=\"mb-3\">\r\n          <label class=\"form-label\">Email address</label>\r\n          <input type=\"email\" class=\"form-control glass-input\" v-model=\"email\" required>\r\n        </div>\r\n        <div class=\"mb-4\">\r\n          <label class=\"form-label\">Password</label>\r\n          <input type=\"password\" class=\"form-control glass-input\" v-model=\"password\" required>\r\n        </div>\r\n        <button type=\"submit\" class=\"btn btn-glass-primary w-100 py-2\">Login</button>\r\n      </form>\r\n      <div class=\"text-center mt-4\">\r\n        <small>Don't have an account? <router-link to=\"/register\" class=\"text-info\">Register here</router-link></small>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../utils/axios';\r\nexport default {\r\n  name: 'Login',\r\n  data() { return { email: '', password: '' } },\r\n  methods: {\r\n    async handleLogin() {\r\n      try {\r\n        const response = await api.post('/auth/login', { email: this.email, password: this.password });\r\n        localStorage.setItem('token', response.data.token);\r\n        localStorage.setItem('role', response.data.role);\r\n        \r\n        const role = response.data.role;\r\n        if (role === 'admin') this.$router.push('/admin');\r\n        else if (role === 'company') this.$router.push('/company');\r\n        else if (role === 'student') this.$router.push('/student');\r\n      } catch (error) {\r\n        alert(\"Login Failed!\");\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAsBA,OAAAA,GAAA;AACA;EACAC,IAAA;EACAC,KAAA;IAAA;MAAAC,KAAA;MAAAC,QAAA;IAAA;EAAA;EACAC,OAAA;IACA,MAAAC,YAAA;MACA;QACA,MAAAC,QAAA,SAAAP,GAAA,CAAAQ,IAAA;UAAAL,KAAA,OAAAA,KAAA;UAAAC,QAAA,OAAAA;QAAA;QACAK,YAAA,CAAAC,OAAA,UAAAH,QAAA,CAAAL,IAAA,CAAAS,KAAA;QACAF,YAAA,CAAAC,OAAA,SAAAH,QAAA,CAAAL,IAAA,CAAAU,IAAA;QAEA,MAAAA,IAAA,GAAAL,QAAA,CAAAL,IAAA,CAAAU,IAAA;QACA,IAAAA,IAAA,mBAAAC,OAAA,CAAAC,IAAA,gBACA,IAAAF,IAAA,qBAAAC,OAAA,CAAAC,IAAA,kBACA,IAAAF,IAAA,qBAAAC,OAAA,CAAAC,IAAA;MACA,SAAAC,KAAA;QACAC,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}