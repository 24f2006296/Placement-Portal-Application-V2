{"ast":null,"code":"import api from '../utils/axios';\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      email: '',\n      password: ''\n    };\n  },\n  methods: {\n    async login() {\n      try {\n        const response = await api.post('/auth/login', {\n          email: this.email,\n          password: this.password\n        });\n\n        // --- THE FIX IS HERE ---\n        // We safely grab ONLY the token string, nothing else!\n        const cleanToken = response.data.token || response.data.access_token;\n        const userRole = response.data.role;\n\n        // Save them to the browser's memory\n        localStorage.setItem('token', cleanToken);\n        localStorage.setItem('role', userRole);\n\n        // Redirect based on role\n        if (userRole === 'admin') {\n          this.$router.push('/admin');\n        } else if (userRole === 'company') {\n          this.$router.push('/company');\n        } else {\n          this.$router.push('/student');\n        }\n      } catch (error) {\n        alert(\"Login failed! Check your email and password.\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","email","password","methods","login","response","post","cleanToken","token","access_token","userRole","role","localStorage","setItem","$router","push","error","alert"],"sources":["src/views/Login.vue"],"sourcesContent":["<template>\r\n  <div class=\"container d-flex justify-content-center align-items-center\" style=\"min-height: 100vh;\">\r\n    <div class=\"glass-card\" style=\"width: 100%; max-width: 400px;\">\r\n      <h2 class=\"text-center mb-4\">Placement Portal</h2>\r\n      <form @submit.prevent=\"handleLogin\">\r\n        <div class=\"mb-3\">\r\n          <label class=\"form-label\">Email address</label>\r\n          <input type=\"email\" class=\"form-control glass-input\" v-model=\"email\" required>\r\n        </div>\r\n        <div class=\"mb-4\">\r\n          <label class=\"form-label\">Password</label>\r\n          <input type=\"password\" class=\"form-control glass-input\" v-model=\"password\" required>\r\n        </div>\r\n        <button type=\"submit\" class=\"btn btn-glass-primary w-100 py-2\">Login</button>\r\n      </form>\r\n      <div class=\"text-center mt-4\">\r\n        <small>Don't have an account? <router-link to=\"/register\" class=\"text-info\">Register here</router-link></small>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../utils/axios';\r\nexport default {\r\n  name: 'Login',\r\n  data() { return { email: '', password: '' } },\r\n  methods: {\r\n    async login() {\r\n      try {\r\n        const response = await api.post('/auth/login', {\r\n          email: this.email,\r\n          password: this.password\r\n        });\r\n        \r\n        // --- THE FIX IS HERE ---\r\n        // We safely grab ONLY the token string, nothing else!\r\n        const cleanToken = response.data.token || response.data.access_token;\r\n        const userRole = response.data.role;\r\n\r\n        // Save them to the browser's memory\r\n        localStorage.setItem('token', cleanToken);\r\n        localStorage.setItem('role', userRole);\r\n\r\n        // Redirect based on role\r\n        if (userRole === 'admin') {\r\n          this.$router.push('/admin');\r\n        } else if (userRole === 'company') {\r\n          this.$router.push('/company');\r\n        } else {\r\n          this.$router.push('/student');\r\n        }\r\n\r\n      } catch (error) {\r\n        alert(\"Login failed! Check your email and password.\");\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAsBA,OAAAA,GAAA;AACA;EACAC,IAAA;EACAC,KAAA;IAAA;MAAAC,KAAA;MAAAC,QAAA;IAAA;EAAA;EACAC,OAAA;IACA,MAAAC,MAAA;MACA;QACA,MAAAC,QAAA,SAAAP,GAAA,CAAAQ,IAAA;UACAL,KAAA,OAAAA,KAAA;UACAC,QAAA,OAAAA;QACA;;QAEA;QACA;QACA,MAAAK,UAAA,GAAAF,QAAA,CAAAL,IAAA,CAAAQ,KAAA,IAAAH,QAAA,CAAAL,IAAA,CAAAS,YAAA;QACA,MAAAC,QAAA,GAAAL,QAAA,CAAAL,IAAA,CAAAW,IAAA;;QAEA;QACAC,YAAA,CAAAC,OAAA,UAAAN,UAAA;QACAK,YAAA,CAAAC,OAAA,SAAAH,QAAA;;QAEA;QACA,IAAAA,QAAA;UACA,KAAAI,OAAA,CAAAC,IAAA;QACA,WAAAL,QAAA;UACA,KAAAI,OAAA,CAAAC,IAAA;QACA;UACA,KAAAD,OAAA,CAAAC,IAAA;QACA;MAEA,SAAAC,KAAA;QACAC,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}